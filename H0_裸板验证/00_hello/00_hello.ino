/*
 * ============================================================
 *  H0 · 裸板验证（今天第一件事）
 * ------------------------------------------------------------
 *  接线：什么都不接！只用 Type-C 线把 ESP32 连到电脑
 *  目的：确认「电脑能认到板子 + 能烧进程序 + 串口能打印」
 *
 *  通过标准：串口监视器每 1 秒出现一行 hello
 * ============================================================
 */

void setup() {
  // Serial.begin(115200) 的作用：打开和电脑通信的"串口"，并约定速度 115200
  // 注意：串口监视器右上角的波特率必须也选 115200，否则看到的是乱码
  Serial.begin(115200);
  Serial.println("\n=== ESP32 起来了 ===");
}

void loop() {
  Serial.println("hello");   // 打印一行 hello
  delay(1000);               // 等 1000 毫秒（1 秒）
}

/*
 * ------------------------------------------------------------
 *  不通过时按这三个方向查：
 *  1. 工具→端口 里没有任何 COMx
 *     → 90% 是数据线问题（充电线没有数据线芯），换一根
 *     → 换线还不行，去设备管理器看有没有带感叹号的未知设备，有就装 CH340 驱动
 *
 *  2. 上传报 "Failed to connect to ESP32: Timed out waiting for packet header"
 *     → 点上传后立刻按住板子上的 BOOT 键，看到底部出现 "Connecting..." 再松手
 *     → 还不行，把上传速度从 921600 降到 115200 再试
 *
 *  3. 上传成功但串口一片空白
 *     → 串口监视器波特率不是 115200
 *     → 或者打开串口时板子被复位了，等一秒再看
 * ------------------------------------------------------------
 */
