/*
 * ============================================================
 *  测试 2 · 超声波验证（不加任何滤波）
 * ------------------------------------------------------------
 *  目的：确认接线正确、能测到距离，并且看清原始数据长什么样
 *  接线：VCC → 3.3V   GND → GND   Trig → GPIO 25   Echo → GPIO 18
 *
 *  ⚠️ 关键：VCC 必须接 3.3V，不能接 5V
 *     5V 供电时 Echo 会输出 5V，直接烧 ESP32 的引脚
 * ============================================================
 */

const int PIN_TRIG = 25;
const int PIN_ECHO = 18;

void setup() {
  Serial.begin(115200);
  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT);
  digitalWrite(PIN_TRIG, LOW);

  Serial.println("\n=== 超声波测试（无滤波）===");
  Serial.println("拿一本书或硬纸板，从远处慢慢靠近，看读数变化");
  Serial.println("脉宽(us)\t距离(cm)");
  Serial.println("-------------------------------");
}

void loop() {
  // ---- 发送 5μs 触发脉冲 ----
  digitalWrite(PIN_TRIG, LOW);
  delayMicroseconds(2);
  digitalWrite(PIN_TRIG, HIGH);
  delayMicroseconds(5);
  digitalWrite(PIN_TRIG, LOW);

  // ---- 测量回波高电平时长（超时 20000μs = 20ms）----
  unsigned long dur = pulseIn(PIN_ECHO, HIGH, 20000);

  // ---- 打印原始脉宽 + 换算距离 ----
  Serial.print(dur);
  Serial.print("\t\t");

  if (dur == 0) {
    Serial.println("无回波（空旷或超量程）");
  } else {
    float d = dur * 0.034 / 2.0;
    Serial.print(d, 1);
    Serial.println(" cm");
  }

  delay(300);   // 每 300ms 测一次，方便肉眼看
}

/*
 * ============================================================
 *  为什么要打印「脉宽」
 * ------------------------------------------------------------
 *  dur（脉宽，微秒）是最原始的数据。距离是它算出来的。
 *  以后任何测距异常，第一步都是看 dur：
 *
 *    dur = 0        → 没有回波，可能是空旷、接线松、或者模块没供电
 *    dur ≈ 2941     → 距离约 50cm（2941 × 0.034 / 2 = 50.0）
 *    dur ≈ 19529    → 距离约 332cm ← 这是盲区假值！记住这个数
 *
 *  只看距离看不出问题出在哪，看脉宽能区分「没测到」和「测错了」。
 * ============================================================
 *
 *  结果判断
 * ------------------------------------------------------------
 *  ✅ 20cm 处读数在 18–22 之间，50cm 处在 48–52 之间
 *     → 接线正确，量程够用
 *
 *  ❌ 一直是 0
 *     → Trig / Echo 接反了；或者 VCC 没接；或者 GND 没共地
 *
 *  ❌ 读数乱跳（比如 5、180、30、2 乱变）
 *     → 反射面太小或角度太斜，换一块大一点的硬纸板正对着
 *     → 或者 VCC 接的不是 3.3V，电压不稳
 *
 *  ❌ 50cm 内正常，再远就变 0 或乱跳
 *     → 你买的不是 P 版（宽压版），3.3V 供电下量程缩水了
 *     → 对你的项目够用（五档最大 100cm），先不换
 *     → 如果非要测远，改成 5V 供电 + Echo 分压（需要两个电阻）
 *
 *  ❌ 近距离（<2cm）时突然跳到 300 多
 *     → 这是正常的盲区现象，下一个测试里会处理掉
 * ============================================================
 */
