/*
 * ============================================================
 *  H2 · 步骤 4：MPU6050 检测有没有接对
 * ------------------------------------------------------------
 *  目的：确认 MPU6050 能被 ESP32 认到（I2C 通信正常）
 *  接线：
 *      MPU6050 VCC → 3.3V
 *      MPU6050 GND → GND
 *      MPU6050 SDA → GPIO 21
 *      MPU6050 SCL → GPIO 22
 *
 *  通过标准：串口打印「发现设备地址: 0x68」
 * ============================================================
 */

#include <Wire.h>          // Wire 是 Arduino 自带的 I2C 库，不用额外安装

void setup() {
  Serial.begin(115200);
  // Wire.begin(SDA, SCL)：告诉 ESP32 用 21 和 22 这两根引脚做 I2C
  // ESP32 默认就是 21/22，但写出来更清楚，也不容易接错
  Wire.begin(21, 22);
  Serial.println("\n=== I2C 扫描开始 ===");
  Serial.println("正常应该扫到 0x68（MPU6050 的固定地址）");
}

void loop() {
  int found = 0;

  // I2C 设备地址范围是 1~126，逐个问"你在不在"
  for (byte addr = 1; addr < 127; addr++) {
    Wire.beginTransmission(addr);        // 向这个地址发起一次通信
    // endTransmission 返回 0 表示"对方应答了"，说明这个地址上有设备
    if (Wire.endTransmission() == 0) {
      Serial.print("发现设备地址: 0x");
      Serial.println(addr, HEX);         // HEX 表示用十六进制打印
      found++;
    }
    delay(5);
  }

  if (found == 0) {
    Serial.println("!! 一个设备都没扫到 !!");
  }
  Serial.println("----------------------------");
  delay(2000);                            // 每 2 秒扫一轮
}

/*
 * ------------------------------------------------------------
 *  不通过时按这三个方向查：
 *  1. 一个都扫不到
 *     → SDA 和 SCL 插反了，这是最常见的错误，两根线交换一次再试
 *     → 或者模块没有供电，量一下 VCC 是不是 3.3V
 *
 *  2. 扫到 0x68 但后面读数据全是 0
 *     → 模块可能是拆机翻新件
 *     → 先确认 GND 和 ESP32 共地（所有 GND 必须连在一起）
 *
 *  3. 扫到了别的地址（比如 0x69）
 *     → 模块上 AD0 引脚接了高电平，属于正常，把这个地址记下来即可
 * ------------------------------------------------------------
 */
