/*
 * ============================================================
 *  H2 · 步骤 5：SOS 按键验证
 * ------------------------------------------------------------
 *  目的：确认按键能读到"按下/松开"
 *  接线（12×12 按键有 4 个脚，一定要用「对角」的两只脚）：
 *      一只脚   → GPIO 13
 *      对角的脚 → GND
 *
 *  为什么必须用对角：
 *      这种按键同侧的两个脚内部是连通的，
 *      如果你把同侧两个脚分别接信号和地，等于一直短路，永远读"按下"
 *
 *  通过标准：手不按打印「松开」，按下打印「按下」
 * ============================================================
 */

const int PIN_BTN = 13;      // 按键接在 GPIO13

void setup() {
  Serial.begin(115200);

  // INPUT_PULLUP：把引脚设成输入，并打开芯片内部的"上拉电阻"
  // 效果是：不按的时候引脚被拉到高电平，按下时被接到 GND 变成低电平
  // 这样只用一根信号线 + 一根地线就能读按键，不需要外接电阻
  pinMode(PIN_BTN, INPUT_PULLUP);

  Serial.println("\n=== 按键测试 ===");
  Serial.println("不按应该打印「松开」，按住应该打印「按下」");
}

void loop() {
  if (digitalRead(PIN_BTN) == LOW) {       // 读到低电平 = 被按下
    Serial.println("按下");
  } else {
    Serial.println("松开");
  }
  delay(200);                              // 200ms 读一次，方便肉眼看
}

/*
 * ------------------------------------------------------------
 *  不通过时按这三个方向查：
 *  1. 一直显示「按下」
 *     → 用了同侧的两个脚（内部本来就连通），换对角的两只脚
 *     → 或者代码里漏了 INPUT_PULLUP
 *
 *  2. 一直显示「松开」
 *     → 信号线没接到 GPIO13
 *     → 另一只脚没接 GND
 *
 *  3. 按一下跳好几次「按下/松开」
 *     → 这叫抖动，属正常现象。正式代码里要加 20ms 消抖：
 *        读到低电平后 delay(20)，再读一次，仍是低电平才算真按下
 * ------------------------------------------------------------
 */
