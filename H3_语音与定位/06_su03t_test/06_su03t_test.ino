/*
 * ============================================================
 *  H3 · 步骤 6：SU-03T 声控验证
 * ------------------------------------------------------------
 *  ⚠️ 前提：模块出厂是空词条，必须先在 smartpi.cn 配好唤醒词
 *     并烧进模块，否则这里什么都收不到（这一步约 1–2 小时，放周末做）
 *
 *  接线：
 *      SU-03T VCC → 3.3V
 *      SU-03T GND → GND
 *      SU-03T TXD → GPIO 16    ← 模块的"发"接 ESP32 的"收"
 *      SU-03T RXD → 不接
 *
 *  通过标准：说唤醒词时，串口冒出一串十六进制（如 AA 55 01 00 FB）
 * ============================================================
 */

void setup() {
  Serial.begin(115200);      // 和电脑通信，看结果
  // Serial2：ESP32 的第二个硬件串口，默认 RX=16 / TX=17
  // 参数顺序：(波特率, 数据格式, RX引脚, TX引脚)
  Serial2.begin(9600, SERIAL_8N1, 16, 17);
  Serial.println("\n=== SU-03T 语音识别测试 ===");
  Serial.println("先说唤醒词，再看串口有没有十六进制输出");
}

void loop() {
  // available() 返回串口里还有几个字节没读
  while (Serial2.available()) {
    int b = Serial2.read();          // 读出一个字节（0~255）

    // 打印成两位十六进制，不足两位前面补 0，方便和文档对照
    if (b < 0x10) Serial.print("0");
    Serial.print(b, HEX);
    Serial.print(" ");
  }
}

/*
 * ------------------------------------------------------------
 *  不通过时按这三个方向查：
 *  1. 完全没有任何输出
 *     → 词条没配/没烧进模块（先去 smartpi.cn 生成固件并烧录）
 *     → TXD 没接到 GPIO16，或者接成了 GPIO17
 *
 *  2. 有输出但是乱码/数字乱跳
 *     → 波特率不对，改成 115200 或 9600 各试一次
 *     → 或者没共地（模块 GND 和 ESP32 GND 必须连一起）
 *
 *  3. 输出的是配置时就定好的固定十六进制
 *     → 这是正常的，模块就是把"识别到哪句话"编码成几个字节发出来
 *     → 后面在代码里判断这几个字节，就知道盲人说的是哪一句
 * ------------------------------------------------------------
 */
