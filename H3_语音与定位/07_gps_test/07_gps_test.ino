/*
 * ============================================================
 *  H3 · 步骤 7：ATGM336H GPS 验证
 * ------------------------------------------------------------
 *  ⚠️ 重要：室内一定收不到星，宿舍/教室基本都是 0 颗。
 *     必须拿到室外空旷处，第一次定位（冷启动）要 1–2 分钟。
 *
 *  接线：
 *      ATGM336H VCC → 3.3V
 *      ATGM336H GND → GND
 *      ATGM336H TXD → GPIO 32    ← 模块的"发"接 ESP32 的"收"
 *      ATGM336H RXD → 不接
 *
 *  通过标准：看到 $GNRMC,...，并且字段里是 A（表示定位有效）
 *            如果是 V，说明还没定上位
 * ============================================================
 */

void setup() {
  Serial.begin(115200);                        // 给电脑看
  // Serial1 默认引脚在 Flash 上不能用，这里把它重映射到 GPIO32(RX) / GPIO33(TX)
  Serial1.begin(9600, SERIAL_8N1, 32, 33);     // GPS 默认波特率 9600
  Serial.println("\n=== GPS 测试（请拿到室外）===");
  Serial.println("等 1~2 分钟，看到 $GNRMC 且带 A 就说明定位成功");
}

void loop() {
  // 把 GPS 发来的 NMEA 语句原样转发到电脑串口
  while (Serial1.available()) {
    Serial.write(Serial1.read());
  }
}

/*
 * ------------------------------------------------------------
 *  NMEA 语句长什么样、怎么看：
 *
 *   $GNRMC,015424.00,A,2123.1234,N,11012.5678,E,0.5,,111126,,,A*6C
 *            │        │  └─纬度    └─经度
 *            │        └─A=定位有效  V=无效
 *            └─UTC 时间
 *
 *  你只需要关心：逗号分隔的第 2 段（A 还是 V）、第 3~6 段（纬度经度）
 *
 * ------------------------------------------------------------
 *  不通过时按这三个方向查：
 *  1. 一直是 V（无效）
 *     → 在室内，正常现象，拿到室外空旷处再试
 *     → 第一次冷启动要等 1–2 分钟，别拔线
 *
 *  2. 完全没有任何数据
 *     → TXD 没接到 GPIO32
 *     → 模块没供电（量 VCC 是不是 3.3V）
 *
 *  3. 有数据但都是乱码
 *     → 波特率不是 9600，改成 115200 试一次
 *
 *  最后提醒：答辩/演示时室内拿不到定位，要用 WiFi 定位做降级预案。
 * ------------------------------------------------------------
 */
